# dsh = 正式大脑（凌云智公开 session-gateway）
# cursor = 仅测试
OFFICEVR_BRAIN=dsh

OFFICEVR_DSH_ORIGIN=http://127.0.0.1:5173
OFFICEVR_DSH_USER=admin
OFFICEVR_DSH_PASSWORD=

# 两个展厅人对应 business_agents.stable_id，空着直到你提供
OFFICEVR_DSH_STABLE_0=
OFFICEVR_DSH_STABLE_1=

# 仅 OFFICEVR_BRAIN=cursor 时使用
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# auto = SenseVoice CPU，装不上则 faster-whisper small CPU
OFFICEVR_ASR=auto
OFFICEVR_WHISPER_MODEL=small

SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8095
