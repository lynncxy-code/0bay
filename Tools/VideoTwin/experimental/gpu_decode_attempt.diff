+    // Decoder picks the GPU surface format when it is offered; otherwise the first (software) one, so a camera the
+    // GPU decoder cannot take still decodes on the CPU.
+    AVPixelFormat PickD3D11(AVCodecContext*, const AVPixelFormat* Formats)
+    {
+        for (const AVPixelFormat* F = Formats; *F != AV_PIX_FMT_NONE; ++F)
+        {
+            if (*F == AV_PIX_FMT_D3D11) return *F;
+        }
+        return Formats[0];
+    }
 }
 
